# R3-MISC-003: *.md excludes all markdown files from Docker build context.
# This is intentional — README/docs are not needed inside containers and
# excluding them reduces build context size. Markdown files that ARE needed
# (e.g. config templates) should be COPY'd explicitly in the Dockerfile.
*.md
.env
.env.local
.env.*.local
.env.production
.env.staging
README.md
*.log
uploads/
coverage/
.nyc_output
.vscode
.idea
*.bat
deploy.sh
infra/nginx/ssl/*.pem
