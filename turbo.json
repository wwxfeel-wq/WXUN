{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env", ".env.production", ".env.local"],
  "globalEnv": [
    "NODE_ENV",
    "PORT",
    "DATABASE_URL",
    "POSTGRES_USER",
    "POSTGRES_PASSWORD",
    "POSTGRES_DB",
    "REDIS_URL",
    "REDIS_PASSWORD",
    "JWT_SECRET",
    "JWT_REFRESH_SECRET",
    "JWT_EXPIRES_IN",
    "JWT_REFRESH_EXPIRES_IN",
    "ENCRYPTION_KEY",
    "AI_ACTIVE_PROVIDER",
    "GLM_API_KEY",
    "GLM_API_URL",
    "GLM_MODEL",
    "GLM_EMBEDDING_MODEL",
    "DEEPSEEK_API_KEY",
    "DEEPSEEK_API_URL",
    "OPENAI_API_KEY",
    "QWEN_API_KEY",
    "CORS_ORIGINS",
    "NEXT_PUBLIC_API_URL",
    "WECHAT_BOT_TOKEN",
    "OPENCLAW_WEBHOOK_SECRET",
    "MIHOME_CLIENT_ID",
    "MIHOME_CLIENT_SECRET",
    "PUPPETEER_EXECUTABLE_PATH",
    "PUPPETEER_SKIP_CHROMIUM_DOWNLOAD",
    "SEED_ADMIN_EMAIL",
    "SEED_ADMIN_PASSWORD",
    "UPLOAD_DIR",
    "MAX_FILE_SIZE",
    "RATE_LIMIT_TTL",
    "RATE_LIMIT_LIMIT",
    "ACR_REGISTRY",
    "ACR_NAMESPACE"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    }
  }
}
