# ===== Application =====
NODE_ENV=development

# R3-ENV-001: .env.production contains real secrets and must NEVER be committed
# to version control. It is listed in .gitignore. Only .env.example should be
# committed. Create .env.production manually on the server.

# ===== Database =====
# R3-ENV-002: Individual Postgres credentials (used by docker-compose)
POSTGRES_USER=echolife
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=echolife
DATABASE_URL=postgresql://echolife:change-me-to-a-strong-password@localhost:5432/echolife?schema=public

# ===== Redis =====
# R3-ENV-002: Redis password (used by docker-compose)
REDIS_PASSWORD=change-me-to-a-strong-redis-password
# R3-ENV-006: When using Redis with a password, the URL format is:
# redis://:<password>@host:port
REDIS_URL=redis://:change-me-to-a-strong-redis-password@localhost:6379

# ===== JWT =====
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ===== Encryption =====
# MUST be a 64-character hex string (32 bytes) for AES-256-GCM.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2

# ===== AI Active Provider =====
# R3-ENV-002: Which AI provider to use (glm | deepseek | openai | qwen)
AI_ACTIVE_PROVIDER=deepseek

# ===== GLM AI API =====
# R3-ENV-003: In production, replace 'your-glm-api-key' with a real API key.
# Never commit real API keys to version control.
GLM_API_KEY=your-glm-api-key
GLM_API_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-plus
GLM_EMBEDDING_MODEL=embedding-3

# ===== DeepSeek API =====
DEEPSEEK_API_KEY=your-deepseek-api-key

# ===== OpenAI API =====
OPENAI_API_KEY=your-openai-api-key

# ===== Qwen API =====
QWEN_API_KEY=your-qwen-api-key

# ===== WeChat ClawBot (iLink Bot API) =====
# 扫码登录后自动获取，留空则需要在前端扫码
# 获取后填入此变量可支持服务器重启后自动恢复连接
WECHAT_BOT_TOKEN=

# ===== OpenClaw 网关 (微信 ClawBot 运行在 OpenClaw 内) =====
# OpenClaw webhook 共享密钥（OpenClaw 和 EchoLife API 必须一致）
OPENCLAW_WEBHOOK_SECRET=suiyan-openclaw-2026

# ===== IoT (Mi Home / 米家) =====
# R3-ENV-002: Optional — obtain from Mi Home developer portal
MIHOME_CLIENT_ID=
MIHOME_CLIENT_SECRET=

# ===== Puppeteer (Screenshot) =====
# R3-ENV-002: Puppeteer configuration for screenshot feature
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

# ===== ACR (Aliyun Container Registry) =====
# R3-ENV-002: Used by docker-compose.deploy.yml to pull pre-built images
ACR_REGISTRY=crpi-xxxxxxxx.cn-hangzhou.personal.cr.aliyuncs.com
ACR_NAMESPACE=your-namespace

# ===== Seed Admin (optional, auto-generated if not set) =====
SEED_ADMIN_EMAIL=admin@echolife.ai
# R3-ENV-005: If you set SEED_ADMIN_PASSWORD, change it immediately after
# first login. Leaving it empty auto-generates a secure random password.
# SEED_ADMIN_PASSWORD=  # Leave empty to auto-generate a secure random password

# ===== Seed Demo Account (体验账号) =====
# 非生产环境默认创建；生产环境需显式打开
# SEED_DEMO_DATA=true
# SEED_USER_EMAIL=demo@echolife.ai
# SEED_USER_PASSWORD=  # Leave empty to auto-generate

# ===== CORS =====
# R3-ENV-004: HTTP origins are included for development. Once HTTPS is enabled
# in production, remove all HTTP origins and keep only HTTPS origins.
CORS_ORIGINS=http://localhost:3000

# ===== Frontend =====
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# ===== File Upload =====
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ===== Rate Limit =====
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100
