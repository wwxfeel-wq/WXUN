# ===== Application =====
NODE_ENV=development

# ===== Database =====
DATABASE_URL=postgresql://echolife:echolife_pass@localhost:5432/echolife?schema=public

# ===== Redis =====
REDIS_URL=redis://localhost:6379

# ===== JWT =====
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ===== Encryption =====
# MUST be a 64-character hex string (32 bytes) for AES-256-GCM.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2

# ===== GLM AI API =====
GLM_API_KEY=your-glm-api-key
GLM_API_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-plus
GLM_EMBEDDING_MODEL=embedding-3

# ===== DeepSeek API =====
DEEPSEEK_API_KEY=your-deepseek-api-key

# ===== OpenAI API =====
OPENAI_API_KEY=your-openai-api-key

# ===== Qwen API =====
QWEN_API_KEY=your-qwen-api-key

# ===== Seed Admin (optional, auto-generated if not set) =====
SEED_ADMIN_EMAIL=admin@echolife.ai
# SEED_ADMIN_PASSWORD=  # Leave empty to auto-generate a secure random password

# ===== CORS =====
CORS_ORIGINS=http://localhost:3000

# ===== Frontend =====
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# ===== File Upload =====
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ===== Rate Limit =====
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100
