# EchoLife API - NestJS Backend Dockerfile
FROM node:20-slim AS base
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
# Skip Puppeteer's bundled Chromium download (system Chromium is used in runner)
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

# ===== Dependencies =====
FROM base AS deps
WORKDIR /app
COPY pnpm-workspace.yaml package.json turbo.json pnpm-lock.yaml ./
COPY apps/api/package.json ./apps/api/
COPY packages/shared/package.json ./packages/shared/
RUN pnpm install --frozen-lockfile

# ===== Build =====
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=deps /app/packages/shared/node_modules ./packages/shared/node_modules
RUN rm -f /app/apps/api/node_modules/@echolife/shared
# CACHE_BUSTER forces cache invalidation for source code layers (ensures latest code is compiled)
ARG CACHE_BUSTER=default
RUN echo "Cache buster: $CACHE_BUSTER"
COPY . .
RUN pnpm --filter @echolife/shared build
RUN pnpm --filter @echolife/api exec prisma generate
RUN pnpm --filter @echolife/api build
# Verify tracking module is compiled (non-fatal: tracking is optional)
RUN test -f /app/apps/api/dist/modules/tracking/tracking.module.js || \
    echo "WARNING: tracking module not compiled (optional)"
RUN test -f /app/apps/api/dist/modules/tracking/tracking.controller.js || \
    echo "WARNING: tracking controller not compiled (optional)"

# ===== Production =====
FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production

# CRITICAL: CACHE_BUSTER must be declared in EVERY stage that needs cache invalidation.
# Previously it was only in builder stage, so BuildKit cached the runner stage from
# old builds (before tracking module was added), bypassing all verification steps.
ARG CACHE_BUSTER=default
RUN echo "Runner cache buster: $CACHE_BUSTER"

# Install Chromium for Puppeteer screenshot support
# R3-DOCKERFILE-003: chromium is not version-pinned. For reproducible builds,
# consider pinning to a specific version (e.g. chromium=131.*). Left unpinned
# for now to avoid breaking on Debian package updates.
RUN apt-get update && apt-get install -y chromium --no-install-recommends && rm -rf /var/lib/apt/lists/*
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Create non-root user
RUN groupadd -r appgroup && useradd -r -g appgroup appuser

COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/apps/api/prisma ./apps/api/prisma
COPY --from=builder /app/apps/api/package.json ./apps/api/
COPY --from=builder /app/packages/shared/dist ./packages/shared/dist
COPY --from=builder /app/packages/shared/package.json ./packages/shared/
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=builder /app/packages/shared/node_modules ./packages/shared/node_modules

# CRITICAL: Verify tracking module exists in the RUNNER stage (non-fatal: tracking is optional)
# This catches cases where COPY --from=builder doesn't transfer all files
RUN test -f /app/apps/api/dist/modules/tracking/tracking.module.js || \
    echo "WARNING: tracking.module.js missing in runner stage (optional)"
RUN test -f /app/apps/api/dist/modules/tracking/tracking.controller.js || \
    echo "WARNING: tracking.controller.js missing in runner stage (optional)"
# Write build marker for runtime verification
RUN echo "BUILD_SHA=$CACHE_BUSTER BUILT_AT=$(date -u +%Y-%m-%dT%H:%M:%SZ)" > /app/apps/api/dist/BUILD_MARKER.txt

# R3-DOCKERFILE-002: Recreate workspace symlink for @echolife/shared.
# This manual symlink workaround is needed because pnpm workspace symlinks
# are not preserved when copying node_modules between build stages. Without
# this, the API cannot resolve @echolife/shared at runtime.
RUN ln -s /app/packages/shared /app/apps/api/node_modules/@echolife/shared

# Set ownership
RUN chown -R appuser:appgroup /app

EXPOSE 3001

# Run migrations then start — migration failure logs warning but does NOT stop startup.
# This ensures the API registers all routes (e.g. tracking) even if DB is temporarily
# unavailable. Database queries will fail at runtime, but the API stays responsive.
# R3-DOCKERFILE-008: Use local prisma binary instead of npx to avoid network
# dependency and reduce startup time.
WORKDIR /app/apps/api
USER appuser
CMD ["sh", "-c", "./node_modules/.bin/prisma migrate deploy && echo 'Migrations OK' || echo 'WARNING: Migration failed, starting API anyway...' ; node dist/main.js"]
