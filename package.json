{
  "name": "echolife",
  "version": "1.0.0",
  "private": true,
  "description": "EchoLife - AI Digital Life OS",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @echolife/api exec prisma migrate dev",
    "db:generate": "pnpm --filter @echolife/api exec prisma generate",
    "db:seed": "pnpm --filter @echolife/api exec prisma db seed",
    "db:studio": "pnpm --filter @echolife/api exec prisma studio"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.0",
    "prettier": "^3.4.0",
    "eslint": "^9.16.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
